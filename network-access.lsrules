{
  "name": "InstruktAI ERPNext",
  "description": "Allow InstruktAI agents to reach their own ERPNext tenant sites. Scoped to the erpnext.instrukt.ai domain, so any signed erpnext binary at any worktree path is covered without a fresh prompt per rebuild.",
  "rules": [
    {
      "action": "allow",
      "process": "any",
      "remote-domains": ["erpnext.instrukt.ai"],
      "direction": "outgoing"
    }
  ]
}
