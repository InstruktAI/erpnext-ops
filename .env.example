# Local development context for the erpnext CLI (site-first).
# This repository holds no state: real operating credentials live in the
# TeleClaude company registry; this file only shapes a local dev context.
ERPNEXT_URL=https://<site-fqdn>
ERPNEXT_API_KEY=<operator_api_key>
ERPNEXT_API_SECRET=<operator_api_secret>
# Values containing spaces must be quoted.
ERPNEXT_COMPANY="<company name>"
# operator (default) or admin
#ERPNEXT_PRIVILEGE=operator
